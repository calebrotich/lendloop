[
  {
    "id": "lendloop-error-handler",
    "name": "W3 · error-handler",
    "active": true,
    "nodes": [
      {
        "parameters": {},
        "id": "w3-error-trigger",
        "name": "Workflow error",
        "type": "n8n-nodes-base.errorTrigger",
        "typeVersion": 1,
        "position": [-400, -140]
      },
      {
        "parameters": {
          "jsCode": "const crypto = require('crypto');\n\nconst payloadIn = $input.first().json || {};\nconst workflow = payloadIn.workflow && payloadIn.workflow.name ? payloadIn.workflow.name : 'unknown workflow';\nconst execution = payloadIn.execution || {};\nconst node = execution.lastNodeExecuted || 'unknown node';\nconst message = execution.error\n  ? String(execution.error.message || execution.error.description || 'Workflow failed')\n  : 'Workflow failed';\nconst executionId = execution.id ? String(execution.id) : 'unknown';\nconst executedAt = Date.now();\n\nconst secret = $env.LENDLOOP_HMAC_SECRET || '';\nconst base = ($env.LENDLOOP_CONVEX_SITE_URL || '').replace(/\\/+$/, '');\nconst payload = JSON.stringify({\n  kind: 'workflow.error',\n  workflow,\n  executionId,\n  occurredAt: executedAt,\n  message: message.slice(0, 400),\n});\nconst timestamp = String(Math.floor(executedAt / 1000));\nconst signature = 'v1=' + crypto.createHmac('sha256', secret).update(timestamp + '.' + payload).digest('hex');\n\nreturn [{\n  json: {\n    url: base + '/n8n/automation-events',\n    payload,\n    timestamp,\n    signature,\n    subject: 'LendLoop automation failed: ' + workflow,\n    text: 'An n8n workflow failed.\\n\\nWorkflow: ' + workflow + '\\nNode: ' + node + '\\nError: ' + message + '\\nExecution: ' + (execution.url || 'n/a') + '\\n',\n  },\n}];"
        },
        "id": "w3-format-error",
        "name": "Format error alert",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-180, -140]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ $json.url }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-LendLoop-Timestamp",
                "value": "={{ $json.timestamp }}"
              },
              {
                "name": "X-LendLoop-Signature",
                "value": "={{ $json.signature }}"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ $json.payload }}",
          "options": {
            "timeout": 10000
          }
        },
        "id": "w3-post-error",
        "name": "Record error event",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [40, -140],
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 5000
      },
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "lendloop-error-alert",
          "responseMode": "responseNode",
          "rawBody": true,
          "options": {
            "rawBody": true
          }
        },
        "id": "w3-webhook",
        "name": "Convex alert webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [-400, 120],
        "webhookId": "lendloop-error-alert"
      },
      {
        "parameters": {
          "jsCode": "const crypto = require('crypto');\n\nconst item = $input.all()[0];\nconst headers = (item.json && item.json.headers) || {};\nconst b64 = item.binary && item.binary.data && item.binary.data.data;\nconst raw = typeof b64 === 'string' ? Buffer.from(b64, 'base64').toString('utf8') : '';\nconst timestamp = String(headers['x-lendloop-timestamp'] || '');\nconst signature = String(headers['x-lendloop-signature'] || '');\nconst secret = $env.LENDLOOP_HMAC_SECRET || '';\nconst tolerance = Number($env.SIGNATURE_TOLERANCE_SECONDS || 300);\n\nconst fail = (reason) => [{ json: { valid: false, reason, body: null } }];\n\nif (!secret) return fail('not_configured');\nif (!raw) return fail('missing_body');\nif (!/^\\d{1,12}$/.test(timestamp)) return fail('bad_timestamp');\nif (Math.abs(Math.floor(Date.now() / 1000) - Number(timestamp)) > tolerance) return fail('stale');\nconst match = /^v1=([0-9a-f]{64})$/.exec(signature);\nif (!match) return fail('bad_signature');\nconst expected = crypto.createHmac('sha256', secret).update(timestamp + '.' + raw).digest('hex');\nif (!crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(match[1]))) return fail('mismatch');\n\nlet body;\ntry {\n  body = JSON.parse(raw);\n} catch (error) {\n  return fail('bad_json');\n}\nif (!body || typeof body !== 'object') return fail('bad_json');\n\nreturn [{ json: { valid: true, reason: 'ok', body } }];"
        },
        "id": "w3-verify",
        "name": "Verify signature",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-180, 120]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "condition-1",
                "leftValue": "={{ $json.valid }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "w3-if",
        "name": "Verified?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [40, 120]
      },
      {
        "parameters": {
          "jsCode": "const alert = $json.body || {};\n\nreturn [{\n  json: {\n    subject: 'LendLoop automation alert',\n    text: 'LendLoop could not deliver a notification.\\n\\nWorkflow: ' + (alert.workflow || 'unknown') + '\\nError: ' + (alert.message || 'unknown') + '\\nLoan: ' + (alert.loanRequestId || 'n/a') + '\\nWhen: ' + new Date(alert.occurredAt || Date.now()).toISOString() + '\\n',\n  },\n}];"
        },
        "id": "w3-format-alert",
        "name": "Format Convex alert",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [260, 40]
      },
      {
        "parameters": {
          "fromEmail": "={{ $env.LENDLOOP_MAIL_FROM }}",
          "toEmail": "={{ $env.LENDLOOP_OPS_EMAIL }}",
          "subject": "={{ $json.subject }}",
          "emailFormat": "text",
          "text": "={{ $json.text }}",
          "options": {}
        },
        "id": "w3-email-alert",
        "name": "Email ops (alert)",
        "type": "n8n-nodes-base.emailSend",
        "typeVersion": 2.1,
        "position": [480, 40],
        "credentials": {
          "smtp": {
            "id": "lendloop-mailpit",
            "name": "LendLoop Mailpit"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 5000
      },
      {
        "parameters": {
          "fromEmail": "={{ $env.LENDLOOP_MAIL_FROM }}",
          "toEmail": "={{ $env.LENDLOOP_OPS_EMAIL }}",
          "subject": "={{ $json.subject }}",
          "emailFormat": "text",
          "text": "={{ $json.text }}",
          "options": {}
        },
        "id": "w3-email-error",
        "name": "Email ops (error)",
        "type": "n8n-nodes-base.emailSend",
        "typeVersion": 2.1,
        "position": [260, -140],
        "credentials": {
          "smtp": {
            "id": "lendloop-mailpit",
            "name": "LendLoop Mailpit"
          }
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 5000
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { \"ok\": true } }}",
          "options": {}
        },
        "id": "w3-ok",
        "name": "Respond 200",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [700, 40]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { \"error\": \"unauthorized\" } }}",
          "options": {
            "responseCode": 401
          }
        },
        "id": "w3-401",
        "name": "Respond 401",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [260, 200]
      }
    ],
    "connections": {
      "Workflow error": {
        "main": [
          [
            {
              "node": "Format error alert",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Format error alert": {
        "main": [
          [
            {
              "node": "Record error event",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Record error event": {
        "main": [
          [
            {
              "node": "Email ops (error)",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Convex alert webhook": {
        "main": [
          [
            {
              "node": "Verify signature",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Verify signature": {
        "main": [
