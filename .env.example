# ---------------------------------------------------------------------------
# LendLoop — environment template
#
#   cp .env.example .env.local    # app + Convex: Clerk, Convex URLs, policy
#   cp .env.example .env          # docker compose: n8n, Postgres, Mailpit
#
# Two files because two tools own them: `pnpm exec convex dev` writes `.env.local`
# and Next.js reads it; `docker compose` reads `.env`. Both are gitignored.
#
# Values Convex functions need must be mirrored onto the deployment, because the
# functions cannot read either file:
#
#   pnpm exec convex env set ADMIN_EMAIL_ALLOWLIST 'you@example.com'
#
# Nothing here is a real secret; never commit a filled copy.
# ---------------------------------------------------------------------------

# --- Clerk -----------------------------------------------------------------
# Dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# JWT template issuer, e.g. https://your-app.clerk.accounts.dev
# Read by convex/auth.config.ts — set it on the Convex deployment too:
#   pnpm exec convex env set CLERK_JWT_ISSUER_DOMAIN '<value>'
CLERK_JWT_ISSUER_DOMAIN=
# Dashboard → Webhooks → signing secret (svix). Only needed once the Clerk
# webhook route is enabled (for role changes made in the Clerk dashboard).
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Convex ----------------------------------------------------------------
# Written by `pnpm exec convex dev`; listed for completeness.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Public origin of the deployment's HTTP actions (…convex.site), used by n8n.
CONVEX_SITE_URL=
# CI/deploy only — never in the app runtime.
CONVEX_DEPLOY_KEY=

# --- Media (Cloudflare R2) --------------------------------------------------
# Server-side only. Convex functions read these from the deployment, not from
# this file, so mirror all five once:
#   pnpm exec convex env set R2_BUCKET_NAME '...'   (and the other four)
# R2_PUBLIC_HOST is the bucket's public custom domain, e.g. cdn.example.com.
# Images are served from https://<R2_PUBLIC_HOST>/<object-key>.
# Next.js also reads it at build/start to allow-list the next/image optimiser,
# so set it in the app environment as well as on the Convex deployment.
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_HOST=

# --- n8n integration -------------------------------------------------------
# Shared secret for HMAC signing in both directions. 32+ random bytes:
#   openssl rand -hex 32
# Convex signs outbound calls and verifies inbound ones with the same value;
# compose.yml hands it to the n8n container as LENDLOOP_HMAC_SECRET.
N8N_HMAC_SECRET=
# n8n webhook base URLs. Local n8n is http://localhost:5678 but Convex Cloud
# cannot reach localhost — use a tunnel in development (see docs/n8n.md for the
# `--config` gotcha):
#   cloudflared tunnel --config /tmp/empty.yml --url http://localhost:5678
N8N_REQUEST_WEBHOOK_URL=
N8N_ERROR_WEBHOOK_URL=
# Public origin used to build deep links in notifications.
# Local dev: http://localhost:3000 · Production: https://lendloopnow.vercel.app
APP_BASE_URL=http://localhost:3000
# Where W3 emails automation alerts (a Mailpit sink in development).
LENDLOOP_OPS_EMAIL=ops@lendloop.test
# Logo in the internal ops-alert template. Customer-facing emails are rendered by
# Convex (convex/lib/emailTemplates.ts) and take the logo from R2_PUBLIC_HOST.
LENDLOOP_LOGO_URL=https://lendloop-cdn.bahasha.app/email/logo-v2.png
# Comma-separated emails promoted to `admin` on first sign-in.
ADMIN_EMAIL_ALLOWLIST=
# How long an HMAC signature stays valid, in seconds.
SIGNATURE_TOLERANCE_SECONDS=300

# --- Observability (optional) ----------------------------------------------
# PostHog browser analytics. Both values are public and required to send events.
# The browser posts to the same-origin /user-profile-fk proxy path so ad blockers
# cannot drop capture requests; HOST is the upstream the Next rewrite forwards
# to. Use https://eu.i.posthog.com or https://us.i.posthog.com for PostHog
# Cloud (the matching asset and app hosts are derived), or a self-hosted origin.
# The rewrite is built with the app, so changing the host requires a rebuild.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Sentry is optional: with no DSN the SDK stays disabled and the app still runs.
# The DSN is a public client key, not a secret. Leave both empty to use the
# project baked into sentry.options.ts, or set one to point at your own project.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source maps upload during `pnpm build` only when this token is present.
# Set it as a CI secret together with SENTRY_ORG and SENTRY_PROJECT.
# SENTRY_AUTH_TOKEN=

# ===========================================================================
# compose.yml only — the rest of this file is also read by Next.js; these are not
# ===========================================================================

# Encrypts n8n credentials at rest. Generate once and keep it stable:
#   openssl rand -hex 32
# Changing it makes every stored credential unreadable.
N8N_ENCRYPTION_KEY=

# n8n Postgres
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=n8n

# Public base URL n8n embeds in webhook URLs. Point it at the tunnel hostname
# when Convex Cloud has to call back in.
N8N_WEBHOOK_BASE=http://localhost:5678

# From address for every workflow email.
LENDLOOP_MAIL_FROM="LendLoop <lendloop@example.test>"

# Mailpit is a local SMTP sink — no real mail leaves the machine.
# Values for the n8n SMTP credential: host `mailpit`, port 1025, no TLS, no auth.
# UI: http://localhost:8025
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
